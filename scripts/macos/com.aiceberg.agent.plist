<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>com.aiceberg.agent</string>
    <key>ProgramArguments</key><array><string>/Library/AIceberg/bin/aiceberg_agent</string></array>
    <key>EnvironmentVariables</key><dict>
        <key>AGENT_ENV_FILE</key><string>/Library/AIceberg/agent.env</string>
    </dict>
    <key>WorkingDirectory</key><string>/Library/AIceberg</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>StandardOutPath</key><string>/var/log/aiceberg-agent.log</string>
    <key>StandardErrorPath</key><string>/var/log/aiceberg-agent.log</string>
</dict></plist>
