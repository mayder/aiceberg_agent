# Variáveis de ambiente para o AIceberg Agent
# Copie para /etc/aiceberg/agent.env (Linux) ou ajuste equivalente em outros SOs.

# Token obrigatório (ou deixe vazio se já existir data/agent.token persistido).
AGENT_TOKEN=COLOQUE_SEU_TOKEN_AQUI

# Log level (info|debug). Em debug, também grava logs em arquivo.
# LOG_LEVEL=debug
# LOG_FILE_PATH=./data/agent.debug.log
# LOG_FILE_MAX_MB=10
# LOG_FILE_MAX_BACKUPS=3

# Base da API (produção já default). Use apenas se precisar apontar para outro ambiente.
# API_BASE_URL=https://api.aiceberg.com.br

# Transporte HTTP
# HTTP_GZIP=false          # defina true para comprimir os envios
# HTTP_IDEMPOTENCY=true    # envia header Idempotency-Key em cada lote
# TLS_INSECURE_SKIP_VERIFY=false  # true apenas em ambientes de teste (ignora verificação TLS)

# Porta do health local (opcional).
# HEALTH_PORT=8081

# Intervais (segundos) opcionais.
# PING_INTERVAL=5
# CONFIG_SYNC_INTERVAL=30

# Modo de operação: direct (default), hub (age como concentrador) ou relay (envia para um hub).
# AGENT_MODE=direct

# Hub/relay
# HUB_URL=https://meu-hub:9090
# HUB_TOKEN=TOKEN_DO_HUB
# HUB_LISTEN_ADDR=:9090
# SKIP_BOOTSTRAP=true   # use em relay puro se não houver API

# Coleta de logs do sistema operacional (SOC)
# OSLOG_ENABLED=true
# OSLOG_FILES=/var/log/auth.log,/var/log/syslog
# OSLOG_CURSOR_PATH=./data/oslogs.cursor
# OSLOG_BATCH_LINES=200
# OSLOG_MAX_BYTES=262144
# OSLOG_INTERVAL=15
# OSLOG_DIAG=false           # true para modo diagnóstico (reporta erros/permissões)
# OSLOG_ENRICH=false         # true para tentar extrair app/pid/level de linhas syslog
# OSLOG_WIN_CHANNELS=Security,System,Application,Microsoft-Windows-Sysmon/Operational

# Inventário (pacotes, hotfixes, apps) para CVEs
# INVENTORY_ENABLED=true

# Caminho para persistir token/estado/prefs, se quiser alterar os defaults:
# AGENT_TOKEN_PATH=/var/lib/aiceberg/agent.token
# AGENT_STATE_PATH=/var/lib/aiceberg/bootstrap.ok
# PREFS_PATH=/var/lib/aiceberg/collect_prefs.json
# OUTBOX_PATH=/var/lib/aiceberg/outbox.db
# OUTBOX_MAX_MB=200
# OUTBOX_MAX_PER_AGENT=100

# Agentless HUB (somente quando AGENT_MODE=hub)
# AGENTLESS_ENABLED=true
# AGENTLESS_POLL_INTERVAL=30
# AGENTLESS_FLUSH_INTERVAL=15
# AGENTLESS_OUTBOX_PATH=/var/lib/aiceberg/agentless_outbox.db
# AGENTLESS_OUTBOX_MAX_MB=50
# AGENTLESS_TARGETS_PATH=/var/lib/aiceberg/agentless_targets.json
# AGENTLESS_JOBS_LIMIT=50
# AGENTLESS_LOCK_SEC=60
# AGENTLESS_FLUSH_BATCH=100
